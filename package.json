{
  "name": "jazz-ai-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbo",
    "fix:jazz-bin": "chmod +x node_modules/jazz-tools/bin/native/jazz-tools-* 2>/dev/null || true",
    "jazz:server": "pnpm fix:jazz-bin && jazz-tools server \"${JAZZ_APP_ID:-759301e8-cc0c-5b12-bd6f-81892d359dc0}\" --port 1625 --data-dir ./data --admin-secret \"${JAZZ_ADMIN_SECRET:-TEST_SECRET}\" --backend-secret TEST_SECRET",
    "schema:push": "pnpm fix:jazz-bin && jazz-tools schema:push \"${JAZZ_APP_ID:-759301e8-cc0c-5b12-bd6f-81892d359dc0}\" --server-url \"${JAZZ_SERVER_URL:-http://127.0.0.1:1625}\" --admin-secret \"${JAZZ_ADMIN_SECRET:-TEST_SECRET}\" --backend-secret TEST_SECRET",
    "dev:local": "sh -c 'pnpm jazz:server & JAZZ_PID=$!; trap \"kill $JAZZ_PID\" EXIT; pnpm dev'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "postinstall": "pnpm fix:jazz-bin"
  },
  "dependencies": {
    "@ai-sdk/gateway": "1.0.0-beta.2",
    "@ai-sdk/openai": "2.0.0-beta.2",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.5.13",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "ai": "5.0.0-beta.2",
    "bufferutil": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.17.0",
    "jazz-nodejs": "^0.14.23",
    "jazz-react": "^0.14.23",
    "jazz-tools": "2.0.0-alpha.10",
    "lucide-react": "^0.471.0",
    "next": "16.1.6",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-hot-toast": "^2.5.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "sharp": "^0.34.2",
    "tailwind-merge": "^2.6.0",
    "tailwindcss-animate": "^1.0.7",
    "ws": "8.14.2",
    "zod": "^3.25.56"
  },
  "optionalDependencies": {
    "jazz-napi-darwin-arm64": "npm:@garden-co/jazz-napi-darwin-arm64@2.0.0-alpha.10",
    "jazz-napi-darwin-x64": "npm:@garden-co/jazz-napi-darwin-x64@2.0.0-alpha.10",
    "jazz-napi-linux-x64-gnu": "npm:@garden-co/jazz-napi-linux-x64-gnu@2.0.0-alpha.10",
    "jazz-napi-win32-x64-msvc": "npm:@garden-co/jazz-napi-win32-x64-msvc@2.0.0-alpha.10"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.2.1+sha512.398035c7bd696d0ba0b10a688ed558285329d27ea994804a52bad9167d8e3a72bcb993f9699585d3ca25779ac64949ef422757a6c31102c12ab932e5cbe5cc92"
}
