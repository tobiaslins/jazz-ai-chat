{
  "name": "jazz-ai-chat",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "test": "sh -c 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; echo \"${JAZZ_APP_ID}\" \"${JAZZ_ADMIN_SECRET}\" \"${JAZZ_BACKEND_SECRET}\" \"${JAZZ_SERVER_URL}\"'",
    "jazz:server": "sh -c 'set -a; [ -f ./.env.local ] && . ./.env.local; set +a; jazz-tools server \"${JAZZ_APP_ID:?JAZZ_APP_ID is required}\" --port 1625 --data-dir ./data --admin-secret \"${JAZZ_ADMIN_SECRET:-TEST_SECRET}\" --backend-secret \"${JAZZ_BACKEND_SECRET:-TEST_SECRET}\"'",
    "dev:local": "sh -c 'pnpm jazz:server & JAZZ_PID=$!; trap \"kill $JAZZ_PID\" EXIT; pnpm dev'",
    "build": "next build",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@ai-sdk/gateway": "1.0.0-beta.2",
    "@ai-sdk/openai": "2.0.0-beta.2",
    "@ai-sdk/provider": "^3.0.8",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.14",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.2.5",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/ws": "^8.5.13",
    "@vercel/analytics": "^1.5.0",
    "@vercel/speed-insights": "^1.2.0",
    "ai": "5.0.0-beta.2",
    "bufferutil": "^4.0.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "framer-motion": "^11.17.0",
    "goober": "^2.1.18",
    "jazz-tools": "2.0.0-alpha.40",
    "lucide-react": "^0.471.0",
    "next": "16.2.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hot-toast": "^2.5.1",
    "react-markdown": "^9.0.3",
    "react-syntax-highlighter": "^15.6.1",
    "sharp": "^0.34.2",
