+function resolveAbsoluteWasmUrlFromInitError(error) {
+    const origin = self.location?.origin;
+    if (!origin)
+        return null;
+    const message = error instanceof Error ? error.message : String(error ?? "");
+    const match = message.match(/(\/[^"'\s]+\.wasm)/);
+    if (!match)
