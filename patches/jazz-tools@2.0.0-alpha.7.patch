+async function runWithRootRelativeFetchSupport(operation) {
+    const globalRef = globalThis;
+    const originalFetch = globalRef.fetch;
+    const origin = self.location?.origin;
+    if (typeof originalFetch !== "function" || !origin) {
+        return operation();
+    }
